# NEXORA — Professional Trading Terminal & Quantitative Intelligence Configuration

# GEMINI_API_KEY: Server-side API key for Google Gemini model synthesis and research assistance.
# Handled securely on the server side only; never exposed to the client.
# In AI Studio, this is automatically injected at runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# FINANCIAL MARKET DATA PROVIDERS (Server-side only — NEVER exposed to browser)
# -----------------------------------------------------------------------------
# 1. CoinGecko (Crypto Spot):
#    - Zero configuration required for live spot prices & real OHLC candles (BTC, ETH, SOL, XRP, etc.)
#    - Optional Pro key below for higher rate limit tier (500 calls/min):
COINGECKO_API_KEY=""

# 2. Finnhub (US Equities & Global Markets):
#    - Free tier provides 60 API calls/min + real-time US trade WebSocket
#    - Obtain a free API key at https://finnhub.io
#    - When configured, NEXORA streams real-time equity quotes and renders historical daily/hourly candles:
FINNHUB_API_KEY=""

# 3. Twelve Data (Multi-Asset Time-Series):
#    - Free tier provides 8 API calls/min + 800 calls/day
#    - Obtain a key at https://twelvedata.com:
TWELVE_DATA_API_KEY=""

# 4. MARKET_DATA_API_KEY: Legacy fallback alias for Finnhub/AlphaVantage compatibility
MARKET_DATA_API_KEY=""

# OPTIONAL SERVICES
# -----------------------------------------------------------------------------
# SEARCH_API_KEY: Optional external web search provider key (Google CSE / Serper / Tavily).
SEARCH_API_KEY=""

# DATABASE_URL: Optional PostgreSQL / Cloud SQL connection string for server-side persistence.
# When unset, NEXORA uses client-side workspace persistence with JSON export/import.
DATABASE_URL=""

# APP_URL: The base URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server listening port (default: 3000)
PORT="3000"

